# Copy to .env and replace every value. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit .env.

POSTGRES_PASSWORD=change-me
UMAMI_APP_SECRET=change-me
# Password for Umami's admin user. The seed step replaces the default one.
UMAMI_ADMIN_PASSWORD=change-me

# Signs browser tokens. At least 32 characters.
PARALLAX_TOKEN_SECRET=change-me-change-me-change-me-change-me
# Shared between the Collector and the writer. Internal network only.
PARALLAX_INTERNAL_KEY=change-me
# Operator console and operator API.
PARALLAX_OPERATOR_KEY=change-me
# true shows the operator console without a key. Demo only.
PARALLAX_OPERATOR_PUBLIC=false

# OTLP key for the demo tenant that has an API. Demo profile only.
PARALLAX_DEMO_API_KEY=change-me

# Leading zero bits the tracker must find before its first event.
PARALLAX_WORK_BITS=12
# true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Public URL of the gateway, as browsers reach it.
PARALLAX_PUBLIC_INGEST_URL=http://localhost:8080
